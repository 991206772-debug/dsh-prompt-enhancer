{
  "name": "dsh-prompt-enhancer",
  "version": "1.0.0",
  "private": true,
  "description": "✨ 用当前默认模型把输入框草稿改写成更完整、可执行的提示词，并写回输入框（不自动发送）。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/cosmokit": "~1.8.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "author": "991206772-debug",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/991206772-debug/dsh-prompt-enhancer.git"
  },
  "homepage": "https://github.com/991206772-debug/dsh-prompt-enhancer#readme",
  "bugs": {
    "url": "https://github.com/991206772-debug/dsh-prompt-enhancer/issues"
  },
  "engines": {
    "node": ">=22.3.0"
  },
  "keywords": [
    "dsh-plugin"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  }
}
